# Server-only environment. Never prefix these variables with VITE_ or ship to React.
HOST=127.0.0.1
PORT=3001
APP_URL=http://localhost:3000/
# REQUIRED: generate a random secret, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Local HTTP only. HTTPS/production must use true.
SESSION_COOKIE_SECURE=false
# true only behind ONE trusted HTTPS proxy; auth must not be directly reachable.
TRUST_PROXY=false
# Blank/incomplete providers return 503, never a fake login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
