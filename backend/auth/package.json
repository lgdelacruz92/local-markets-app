{
  "name": "@local-markets/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
